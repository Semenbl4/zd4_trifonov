<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="zd4_trifonov.Views.ResultPage">
	<ContentPage.Resources>
		<StyleSheet Source="/Views/styles.css" />
	</ContentPage.Resources>

	<StackLayout StyleClass="mainBg" Padding="25" Spacing="20" VerticalOptions="FillAndExpand">
		<Label Text="Итоги рассчёта " FontSize="25" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,20,0,10" />

		<Frame CornerRadius="10" Padding="15" BackgroundColor="#2D3035" HasShadow="False">
			<StackLayout Spacing="12">
				<Label x:Name="TypeLabel" Text="Вид платежа: " FontAttributes="Bold" TextColor="#E91E63" />
				<Label x:Name="DescriptionLabel" Text="Расшифровка: " TextColor="#8F9296" />
				<Label x:Name="MaxSliderLabel" Text="Макс. ставка ползунка: " />
				<BoxView HeightRequest="1" BackgroundColor="#3E4249" Margin="0,5" />
				<Label x:Name="MonthPayLabel" Text="Ежемесячный платеж: " FontAttributes="Bold" />
				<Label x:Name="TotalPayLabel" Text="Общая сумма: " />
				<Label x:Name="OverpayLabel" Text="Переплата: " />
			</StackLayout>
		</Frame>
		<Button Text="Назад к калькулятору" Clicked="OnBackClicked" BackgroundColor="#E91E63" TextColor="White" />
	</StackLayout>
</ContentPage>